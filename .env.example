AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-5-mini
# Required only for AI_PROVIDER=openai_compatible.
AI_BASE_URL=https://api.openai.com/v1
QUERY_TIMEOUT_SECONDS=15
MAX_QUERY_ROWS=500
SCHEMA_CATEGORICAL_VALUE_LIMIT=50
NEGLIGIBLITY_THRESHOLD_PERCENT=2.0
# Decimal places used when a report displays a relative percentage change.
REPORT_PERCENT_DECIMAL_PLACES=2
# Fallback reliability for a research agent that does not specify its own.
SOURCE_RELIABILITY_DEFAULT=0.65
# Ask the user to define a business measure when the model is less confident
# than this value, rather than silently choosing a measure from catalog terms.
METRIC_DEFINITION_CONFIDENCE=0.75
# Investigation runtime controls. These apply to every new investigation.
INVESTIGATION_MAX_ITERATIONS=8
INVESTIGATION_MAX_SQL_QUERIES=12
INVESTIGATION_MAX_EXTERNAL_CALLS=2
INVESTIGATION_MAX_DURATION_SECONDS=180
# Set true only for an intentionally unbounded investigation. SQL safety and
# result-row limits remain enforced.
IGNORE_INVESTIGATION_LIMITS=false
# Weather coverage for a country or region: generate approximately one
# polygon-clipped sample point per this many square kilometres. A city or
# other single known location uses one point regardless of this value.
TARGET_CELL_AREA_KM2=2500
# Maximum coordinates sent in one weather-provider request. Larger geographic
# samples are split into multiple requests.
MAX_POINTS_WEATHER_API=150
WEB_ORIGIN=http://localhost:3000
CHECKPOINT_DATABASE_URL=postgresql://investigator:investigator@localhost:5432/catalog
CHECKPOINT_POOL_MIN_SIZE=1
CHECKPOINT_POOL_MAX_SIZE=10
CHECKPOINT_SCHEMA=business_signals
# JSON catalog of enabled built-in and user-configured research agents.  API keys
# are referenced by environment-variable name in this file, never written to it.
RESEARCH_AGENT_CATALOG_PATH=config/research-agents.json
# Optional. Enables the catalog-defined FRED US macroeconomic-data agent.
FRED_API_KEY=
# Optional. Enables the catalog-defined Guardian historic-news agent.
GUARDIAN_API_KEY=
